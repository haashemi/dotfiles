// https://yalter.github.io/niri/Configuration%3A-Window-Rules.html

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


window-rule {
    geometry-corner-radius 0 // 10
    clip-to-geometry true
}

window-rule {
    match app-id="^Alacritty$"

    background-effect {
        blur true
    }
}

// Aurora (QuickShell) surfaces request their own rounded blur shapes via
// ext-background-effect; switch them from xray (blurred wallpaper only) to real
// blur of whatever is behind them.
layer-rule {
    match namespace="^aurora-"

    background-effect {
        xray false
    }
}
